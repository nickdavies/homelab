# The installed Talos version: config-gen.sh tags each node's install image
# with it. Renovate moves it with the last rollout stage (the Pi), so it only
# changes once every node runs the new version.
# renovate: datasource=docker depName=ghcr.io/siderolabs/talos
TALOS_VERSION=v1.14.5
# The config contract config-gen.sh generates for (talosctl gen config
# --talos-version), separate from TALOS_VERSION: it picks the generator's
# defaults and layout, and a newer one restructures the whole config. v1.14
# moves Kubernetes settings out of v1alpha1 into separate documents, which every
# patch here would have to follow. Talos runs configs generated for older
# contracts, so this moves only as its own change, never with an upgrade.
TALOS_CONFIG_CONTRACT=v1.13
KUBE_VERSION="v1.33.2"

VIP=192.168.254.10

CLUSTER_ENDPOINT="https://$VIP:6443"
CLUSTER_NAME="homelab-cluster"

FLUX_REPO_URL="ssh://git@github.com/nickdavies/homelab.git"

# Versions of the bootstrap manifests in patches/. Talos only re-applies these
# on bootstrap and `talosctl upgrade-k8s`, so a bump here changes nothing live
# until then. Unquoted so Renovate's annotation regex reads a bare version.
#
# Only for what nothing in kubernetes/ manages: Talos force-applies these on
# every upgrade-k8s, over whatever else owns the fields.

# renovate: datasource=github-releases depName=kubernetes-sigs/metrics-server
METRICS_SERVER_VERSION=v0.7.2

# renovate: datasource=github-releases depName=alex1989hu/kubelet-serving-cert-approver
KUBELET_SERVING_CERT_APPROVER_VERSION=v0.12.1
