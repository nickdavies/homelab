{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigests",
    "github>nickdavies/homelab//.renovate/autoMerge.json5",
    "github>nickdavies/homelab//.renovate/customManagers.json5",
    "github>nickdavies/homelab//.renovate/grafanaDashboards.json5",
    "github>nickdavies/homelab//.renovate/groups.json5",
    "github>nickdavies/homelab//.renovate/hostRules.json5",
    "github>nickdavies/homelab//.renovate/labels.json5",
    "github>nickdavies/homelab//.renovate/semanticCommits.json5",
    ":automergeBranch",
    ":disableRateLimiting",
    ":dependencyDashboard",
    ":semanticCommits",
    ":timezone(America/Denver)",
  ],
  dependencyDashboardTitle: "Renovate Dashboard 🤖",
  suppressNotifications: [
    "prEditedNotification",
    "prIgnoreNotification",
  ],
  ignorePaths: [
  ],
  packageRules: [
    {
      // Tags are the NUT version plus the Alpine package release (2.8.5-r1).
      // Docker versioning treats "-r1" as a compatibility suffix and would never
      // offer 2.8.5-r2 or 2.8.6, so read the release as a build number instead.
      matchDatasources: ["docker"],
      matchPackageNames: ["instantlinux/nut-upsd"],
      versioning: "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:-r(?<build>\\d+))?$",
    },
    {
      // One PR per Flux minor, merged lowest first, so each minor's release
      // notes get read and its API migrations land before the next.
      matchPackageNames: ["fluxcd/flux2"],
      separateMultipleMinor: true,
    },
    {
      // Talos may only move one minor at a time, and Tuppr doesn't enforce it.
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/siderolabs/talos"],
      separateMinorPatch: true,
    },
    // One PR per rollout stage (kubernetes/apps/system-upgrade/tuppr/upgrades),
    // merged in order. Without a distinct branch prefix Renovate would put all
    // four files in one PR.
    {
      matchPackageNames: ["ghcr.io/siderolabs/talos"],
      matchFileNames: ["kubernetes/apps/system-upgrade/tuppr/upgrades/talosupgrade-1-canary.yaml"],
      additionalBranchPrefix: "talos-1-canary-",
      commitMessageSuffix: "(1/4 canary)",
    },
    {
      matchPackageNames: ["ghcr.io/siderolabs/talos"],
      matchFileNames: ["kubernetes/apps/system-upgrade/tuppr/upgrades/talosupgrade-2-workers.yaml"],
      additionalBranchPrefix: "talos-2-workers-",
      commitMessageSuffix: "(2/4 workers)",
    },
    {
      matchPackageNames: ["ghcr.io/siderolabs/talos"],
      matchFileNames: ["kubernetes/apps/system-upgrade/tuppr/upgrades/talosupgrade-3-controlplane.yaml"],
      additionalBranchPrefix: "talos-3-controlplane-",
      commitMessageSuffix: "(3/4 control plane)",
    },
    {
      // The last stage also moves talosenv, so renders match once every node is done.
      matchPackageNames: ["ghcr.io/siderolabs/talos"],
      matchFileNames: [
        "kubernetes/apps/system-upgrade/tuppr/upgrades/talosupgrade-4-pi.yaml",
        "talos/talosenv",
      ],
      additionalBranchPrefix: "talos-4-pi-",
      commitMessageSuffix: "(4/4 Pi)",
    },
  ],
  flux: {
    managerFilePatterns: ["/(^|/)kubernetes/.+\\.ya?ml$/"]
  },
  "helm-values": {
    managerFilePatterns: ["/(^|/)kubernetes/.+\\.ya?ml$/"]
  },
  kubernetes: {
    managerFilePatterns: ["/(^|/)kubernetes/.+\\.ya?ml$/"]
  },
}
